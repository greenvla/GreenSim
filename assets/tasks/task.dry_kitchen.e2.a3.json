{
  "task"       : {
    "name"       : "dry_kitchen.e2.a3",
    "description": "Pick up the tea can with your left hand and place the tea can on the tray"
  },
  "objects"    : {
    "tea_can_items"   : {"model_tea_can_v2": []                                                       },
    "tray_area_guides": {                        "tray_area_guide": []                                },
    "left_hand_parts" : {                                               "left_thumb_proximal_base": []},
    "robot_parts"     : {                                               "left_thumb_proximal_base": []}
  },
  "relations"  : {
    "episode_timeout"     : {"type": "timeout", "duration_sec": 300.0, "pattern": "episode timeout"},
    "exists_tea_can"      : {"type": "spawn", "pattern": "spawn {tea_can_items}"},
    "exists_tray_area"    : {"type": "spawn", "pattern": "spawn {tray_area_guides}"},
    "tea_can_in_left_hand": {
      "type"    : "distance",
      "pattern" : "pick {tea_can_items} by {left_hand_parts}",
      "distance": 0.15
    },
    "tea_can_in_tray_area": {"type": "inside", "pattern": "place {tea_can_items} into {tray_area_guides}"},
    "tea_can_upright"     : {
      "type"          : "upright",
      "pattern"       : "tea can is upright {tea_can_items}",
      "reference_mode": "spawn",
      "max_tilt_deg"  : 15.0
    },
    "tea_can_static"      : {
      "type"       : "static",
      "pattern"    : "tea can is stationary {tea_can_items}",
      "lin_vel_eps": 0.02,
      "ang_vel_eps": 0.05
    }
  },
  "goals"      : {
    "tea_can_placed_correctly": {
      "description": "The tea can must be inside the tray area, upright, and stationary",
      "for_each"   : "tea_can_items",
      "must_have"  : ["tea_can_in_tray_area", "tea_can_upright", "tea_can_static"],
      "required"   : true
    }
  },
  "constraints": {
    "no_episode_timeout": {
      "description" : "The episode must not end due to timeout",
      "forbid_value": ["episode_timeout", 1],
      "per_object"  : false
    }
  },
  "success"    : { "required_goals": ["tea_can_placed_correctly"], "max_violations": {"no_episode_timeout": 0} }
}
