{
  "task"       : {
    "name": "sber_shop.e2.a1",
    "description": "Approach the rack, pick up the center notebook with your right hand, approach the basket, place the notebook into the basket with your right hand"
  },
  "objects"    : {
    "notebook"            : {"bloknot": []},
    "all_notebooks"       : {"bloknot": [], "bloknot_right": [], "bloknot_left": []},
    "distractor_notebooks": {"bloknot_right": [], "bloknot_left": []},
    "task_success_box"    : {"task_success_box": []},
    "robot_parts"         : {"right_thumb_proximal_base": []}
  },
  "relations"  : {
    "episode_timeout"              : {"type": "timeout", "duration_sec": 120.0, "pattern": "episode timeout"},
    "notebook_in_hand"             : {
      "type"    : "distance",
      "pattern" : "pick {all_notebooks} by {robot_parts}",
      "distance": 0.2
    },
    "notebook_in_basket"           : {"type": "inside", "pattern": "{all_notebooks} is inside {task_success_box}"},
    "distractor_notebook_in_hand"  : {
      "type"    : "distance",
      "pattern" : "pick {distractor_notebooks} by {robot_parts}",
      "distance": 0.2
    },
    "distractor_notebook_in_basket": {
      "type"   : "inside",
      "pattern": "{distractor_notebooks} is inside {task_success_box}"
    },
    "exists_notebook"              : {"type": "spawn", "pattern": "spawn {notebook}"},
    "exists_distractor_notebooks"  : {"type": "spawn", "pattern": "spawn {distractor_notebooks}"},
    "exists_task_success_box"      : {"type": "spawn", "pattern": "spawn {task_success_box}"}
  },
  "goals"      : {
    "notebook_placed_in_basket": {
      "description": "The center notebook must be placed into the basket",
      "for_each"   : "notebook",
      "must_have"  : "notebook_in_basket",
      "required"   : true
    }
  },
  "constraints": {
    "no_episode_timeout": {
      "description" : "The episode must not end due to timeout",
      "forbid_value": ["episode_timeout", 1],
      "per_object"  : false
    },
    "distractor_notebooks_must_stay_out_of_basket": {
      "description" : "Distractor notebooks must not be placed into the basket",
      "forbid_value": ["distractor_notebook_in_basket", 1],
      "per_object"  : true
    }
  },
  "success"    : {
    "required_goals": ["notebook_placed_in_basket"],
    "max_violations": {"no_episode_timeout": 0, "distractor_notebooks_must_stay_out_of_basket": 0}
  }
}
