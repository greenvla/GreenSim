{
  "task"       : {
    "name": "darkstore.e1.a2",
    "description": "Pick the red soda can up with your right hand, place the red soda can in the empty space next to the matching red soda cans"
  },
  "objects"    : {
    "target_item"       : {"red_soda_can__task2_target_drink": []},
    "neighbour_items"   : {
      "back_red_soda_can_1": [0, 1, 2, 3, 4, 5],
      "back_red_soda_can_2": [0, 1, 2, 3      ],
      "back_red_soda_can_3": [0, 1, 2, 3, 4, 5]
    },
    "drinks_shelf_zone" : {"task_success_box": []},
    "right_hand"        : {"right_thumb_proximal_base": []},
    "robot_parts"       : {"right_thumb_proximal_base": []},
    "target_lifted_area": {"target_can_lifted_area": []}
  },
  "relations"  : {
    "episode_timeout": {"type": "timeout", "duration_sec": 35.0, "pattern": "episode timeout"},
    "target_exists": {"type": "spawn", "pattern": "spawn {target_item}"},
    "neighbours_exist": {"type": "spawn", "pattern": "spawn {neighbour_items}"},
    "target_lifted_area_exists": {"type": "spawn", "pattern": "spawn {target_lifted_area}"},
    "drinks_shelf_zone_exists": {"type": "spawn", "pattern": "spawn {drinks_shelf_zone}"},
    "target_in_lifted_area": {"type": "inside", "pattern": "{target_item} is inside {target_lifted_area}"},
    "target_was_lifted_from_shelf": {
      "type"        : "duration",
      "relation"    : "target_in_lifted_area",
      "duration_sec": 0.30,
      "latch"       : true,
      "pattern"     : "{target_item} remains inside {target_lifted_area}"
    },
    "target_on_drinks_shelf": {"type": "inside", "pattern": "{target_item} is inside {drinks_shelf_zone}"},
    "target_upright": {"type": "upright", "pattern": "{target_item} is upright", "max_tilt_deg": 30.0},
    "target_static": {
      "type"       : "static",
      "pattern"    : "{target_item} is static",
      "lin_vel_eps": 0.02,
      "ang_vel_eps": 0.05
    },
    "neighbour_upright": {"type": "upright", "pattern": "{neighbour_items} is upright", "max_tilt_deg": 30.0},
    "target_in_hand": {
      "type"      : "distance",
      "pattern"   : "{target_item} is too close to {robot_parts}",
      "distance"  : 0.17,
      "comparison": "less"
    },
    "target_was_picked_by_right_hand": {
      "type"        : "duration",
      "relation"    : "target_in_hand",
      "duration_sec": 0.5,
      "latch"       : true,
      "pattern"     : "{target_item} remains close to {robot_parts}"
    },
    "target_not_held_by_right_hand": {
      "type"      : "distance",
      "pattern"   : "{target_item} is released by {robot_parts}",
      "distance"  : 0.17,
      "comparison": "greater"
    }
  },
  "goals"      : {
    "target_picked_by_right_hand"  : {
      "description": "The target can must be picked up by the right hand",
      "for_each"   : "target_item",
      "must_have"  : ["target_was_picked_by_right_hand"],
      "required"   : true
    },
    "target_lifted_from_shelf"     : {
      "description": "The target can must be lifted from the shelf into the lifted area and remain there for at least 0.3 seconds",
      "for_each": "target_item",
      "must_have": ["target_was_lifted_from_shelf"],
      "required": true
    },
    "target_placed_on_drinks_shelf": {
      "description": "The target can must be inside the drinks-shelf placement area, upright, and stationary",
      "for_each"   : "target_item",
      "must_have"  : ["target_on_drinks_shelf", "target_upright", "target_static"],
      "required"   : true
    },
    "neighbours_upright_at_finish" : {
      "description": "Every active neighbouring can must be upright at the end of the episode",
      "for_each"   : "neighbour_items",
      "must_have"  : "neighbour_upright",
      "required"   : true,
      "include_in_scoring": false
    },
    "target_released_by_right_hand": {
      "description": "The right hand must move away from the target can after placing it",
      "for_each"   : "target_item",
      "must_have"  : ["target_not_held_by_right_hand"],
      "required"   : true,
      "include_in_scoring": false
    }
  },
  "constraints": {
    "no_episode_timeout"      : {
      "description" : "The episode must not end due to timeout",
      "forbid_value": ["episode_timeout", 1],
      "per_object"  : false
    },
    "target_released"         : {
      "description" : "The robot must not remain close to the target can at the end",
      "forbid_value": ["target_in_hand", 1],
      "per_object"  : false
    },
    "neighbours_must_not_fall": {
      "description"      : "No active neighbouring can may transition from upright to fallen",
      "forbid_transition": [ "neighbour_upright", [1, 0] ],
      "if_object_type"   : "neighbour_items",
      "per_object"       : true
    }
  },
  "success"    : {
    "required_goals": [
      "target_picked_by_right_hand",   "target_lifted_from_shelf",      "target_placed_on_drinks_shelf",
      "neighbours_upright_at_finish",  "target_released_by_right_hand"
    ],
    "max_violations": {"no_episode_timeout": 0, "target_released": 0, "neighbours_must_not_fall": 0}
  }
}
