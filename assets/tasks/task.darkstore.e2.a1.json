{
  "task"       : {
    "name": "darkstore.e2.a1",
    "description": "Approach the orange can, pick the orange can from the shelf with your right hand, place the can into the basket with your right hand"
  },
  "objects"    : {
    "target_items"    : {"orange_soda_can__task1_target_goods_01": []},
    "basket_container": {"basket_guide": []},
    "robot_parts"     : {"right_thumb_proximal_base": []}
  },
  "relations"  : {
    "episode_timeout"        : {"type": "timeout", "duration_sec": 55.0, "pattern": "episode timeout"},
    "in_hand"                : {
      "pattern" : "pick {target_items} by {robot_parts}",
      "type"    : "distance",
      "distance": 0.25
    },
    "in_basket"              : {"pattern": "{target_items} is inside {basket_container}", "type": "inside"},
    "exists_items"           : {"pattern": "spawn {target_items}", "type": "spawn"},
    "exists_basket_container": {"pattern": "spawn {basket_container}", "type": "spawn"}
  },
  "goals"      : {
    "can_in_basket": {
      "description": "The orange can must be placed in the basket",
      "for_each"   : "target_items",
      "must_have"  : "in_basket",
      "required"   : true
    }
  },
  "constraints": {
    "no_episode_timeout": {
      "description" : "The episode must not end by timeout",
      "forbid_value": ["episode_timeout", 1],
      "per_object"  : false
    }
  },
  "success"    : { "required_goals": ["can_in_basket"], "max_violations": {"no_episode_timeout": 0} }
}
